DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional. Use this for instant command updates in one server while developing.
DISCORD_GUILD_ID=

# Defaults to the Singapore Riftbound leaderboard.
LEADERBOARD_URL=https://www.eloshowdown.com/riftbound/leaderboard/singapore/

# Cache tuning. Cards rarely change mid-day; leaderboard changes more often.
CARD_CACHE_TTL_MINUTES=360
LEADERBOARD_CACHE_TTL_SECONDS=300
